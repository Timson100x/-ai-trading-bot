# Example Development Configuration
# Copy this to .env and update with your actual values

# ==============================================
# REQUIRED CONFIGURATION
# ==============================================

# Anthropic API Key (Required for AI features)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Wallet Private Keys (Required for trading)
# Format: Base58 encoded private keys, comma-separated for rotation
# WARNING: Keep these secure! Never commit to git!
WALLET_PRIVATE_KEYS=5Jxxx...,3Nxxx...
WALLET_ROTATION_INTERVAL=3600000

# ==============================================
# RPC CONFIGURATION
# ==============================================

# Solana RPC Endpoints (Mainnet)
SOLANA_RPC_PRIMARY=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_1=https://solana-api.projectserum.com
SOLANA_RPC_FALLBACK_2=https://rpc.ankr.com/solana

# For Testing: Use Devnet
# SOLANA_RPC_PRIMARY=https://api.devnet.solana.com
# SOLANA_RPC_FALLBACK_1=https://rpc.ankr.com/solana_devnet

# ==============================================
# TELEGRAM NOTIFICATIONS (Optional but Recommended)
# ==============================================

# Telegram Bot Token
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Telegram Chat ID
# Get from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# ==============================================
# REDIS CONFIGURATION
# ==============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# For Docker: Use service name
# REDIS_HOST=redis

# ==============================================
# AI CONFIGURATION
# ==============================================

# Claude Model (Options: claude-3-5-sonnet-20241022, claude-3-opus-20240229)
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=1024

# ==============================================
# TRADING CONFIGURATION
# ==============================================

# Trade Limits (Start Conservative!)
MAX_TRADE_AMOUNT=0.1
MIN_TRADE_AMOUNT=0.01
SLIPPAGE_TOLERANCE=0.01
MAX_CONCURRENT_TRADES=5
TRADE_COOLDOWN_MS=1000

# ==============================================
# RISK MANAGEMENT
# ==============================================

# Risk Profile: conservative | moderate | aggressive
RISK_PROFILE=moderate

# Position Sizing
MAX_POSITION_SIZE=0.1

# Stop Loss / Take Profit
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.15

# ==============================================
# DEX CONFIGURATION
# ==============================================

JUPITER_API_URL=https://quote-api.jup.ag/v6
ORCA_API_URL=https://api.orca.so
RAYDIUM_API_URL=https://api.raydium.io

# ==============================================
# WHALE TRACKING
# ==============================================

# Whale Wallet Addresses (comma-separated)
# Add known successful trader addresses to copy their trades
WHALE_WALLET_ADDRESSES=

# Minimum transaction size to consider (in SOL)
MIN_WHALE_TRANSACTION_SIZE=100

# ==============================================
# LOGGING
# ==============================================

# Log Level: error | warn | info | debug
LOG_LEVEL=info

# Log Format: json | text
LOG_FORMAT=json

# ==============================================
# PERFORMANCE & SECURITY
# ==============================================

# Mempool Analysis (Advanced feature)
MEMPOOL_ANALYSIS_ENABLED=false

# Frontrunning Detection (Use ethically!)
FRONTRUNNING_DETECTION_ENABLED=false

# Cache TTL in seconds
CACHE_TTL_SECONDS=60

# ==============================================
# NOTES
# ==============================================

# 1. Start with small MAX_TRADE_AMOUNT (0.01-0.1 SOL)
# 2. Use conservative risk profile initially
# 3. Enable Telegram notifications for monitoring
# 4. Test on devnet first if possible
# 5. Never commit this file to git!
# 6. Keep your private keys secure
# 7. Monitor logs regularly
# 8. Set up proper backups

# ==============================================
# EXAMPLE CONSERVATIVE SETUP
# ==============================================

# MAX_TRADE_AMOUNT=0.01
# MIN_TRADE_AMOUNT=0.005
# RISK_PROFILE=conservative
# MAX_CONCURRENT_TRADES=3
# STOP_LOSS_PERCENTAGE=0.03
# TAKE_PROFIT_PERCENTAGE=0.10

# ==============================================
# EXAMPLE AGGRESSIVE SETUP
# ==============================================

# MAX_TRADE_AMOUNT=1.0
# MIN_TRADE_AMOUNT=0.1
# RISK_PROFILE=aggressive
# MAX_CONCURRENT_TRADES=10
# STOP_LOSS_PERCENTAGE=0.10
# TAKE_PROFIT_PERCENTAGE=0.30
