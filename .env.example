# Solana RPC Configuration
SOLANA_RPC_PRIMARY=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_1=https://solana-api.projectserum.com
SOLANA_RPC_FALLBACK_2=https://rpc.ankr.com/solana

# Wallet Configuration (use comma-separated for rotation)
WALLET_PRIVATE_KEYS=your_base58_private_key_1,your_base58_private_key_2
WALLET_ROTATION_INTERVAL=3600000

# AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=1024

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Trading Configuration
MAX_TRADE_AMOUNT=1.0
MIN_TRADE_AMOUNT=0.01
SLIPPAGE_TOLERANCE=0.01
MAX_CONCURRENT_TRADES=5
TRADE_COOLDOWN_MS=1000

# Risk Management
RISK_PROFILE=medium
MAX_POSITION_SIZE=0.1
STOP_LOSS_PERCENTAGE=0.05
TAKE_PROFIT_PERCENTAGE=0.15

# DEX Configuration
JUPITER_API_URL=https://quote-api.jup.ag/v6
ORCA_API_URL=https://api.orca.so
RAYDIUM_API_URL=https://api.raydium.io

# Whale Tracking
WHALE_WALLET_ADDRESSES=whale_address_1,whale_address_2
MIN_WHALE_TRANSACTION_SIZE=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
MEMPOOL_ANALYSIS_ENABLED=true
FRONTRUNNING_DETECTION_ENABLED=true
CACHE_TTL_SECONDS=60
